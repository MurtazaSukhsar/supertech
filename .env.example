# ---- Supabase -------------------------------------------------------------
# Project Settings -> API. The first two are safe to expose; the service role
# key is not — it bypasses row level security, so keep it server-side only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudinary -----------------------------------------------------------
# Dashboard -> Settings -> API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=super-tech/products

# ---- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://supertechint.com.kw

# Dedicated hostname that serves the admin panel (proxy.ts). Bare hostname
# only — no protocol, no trailing slash. "www.<value>" is also accepted
# automatically. Leave unset for local dev: /admin then works the old way,
# reachable by path on whatever host is serving the app.
NEXT_PUBLIC_ADMIN_DOMAIN=supertechintl.in

# ---- EmailJS (contact form) ----------------------------------------------
# emailjs.com -> Email Services / Email Templates / Account -> API Keys
# All three are public-safe (client-side); lock down with EmailJS domain allowlist.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_AUTOREPLY_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
